# Copy to .env and adjust. Every value below is a public default for a local
# demo stack; none is a credential. .env is git-ignored.

# Mosquitto (edge MQTT broker)
MQTT_HOST=localhost
MQTT_PORT=1883

# ThingsBoard
TB_HOST=localhost
# Host port for the ThingsBoard web UI and REST API. 8080 collides with other
# local stacks (for example Airflow); change it here if needed.
TB_HTTP_PORT=8080
TB_MQTT_PORT=9883
# Device access token for the demo device; scripts/thingsboard/import_rule_chains.py
# makes sure the device exists with this token, and exits if it is unset.
# DHT11_DEMO_TOKEN is the public ThingsBoard demo default.
TB_ACCESS_TOKEN=DHT11_DEMO_TOKEN
# Access token of the pipeline gateway device, through which the ThingsBoard
# sink publishes for every asset (ThingsBoard gateway MQTT API). The import
# script creates the device with this token, and the sink reads it from the
# environment (make exports .env). PIPELINE_GW_DEMO is a local demonstration
# value, not a secret, like DHT11_DEMO_TOKEN above: it only works against the
# ThingsBoard this stack starts on this machine. Set your own value in .env
# for anything else.
TB_GATEWAY_TOKEN=PIPELINE_GW_DEMO
# Host of ThingsBoard's MQTT transport as the sink sees it (TB_MQTT_PORT above).
TB_HOST=localhost
# Tenant account used by the rule-chain import script. The ThingsBoard CE
# public defaults are tenant@thingsboard.org / tenant; set the password in .env.
TB_TENANT_USERNAME=tenant@thingsboard.org
TB_TENANT_PASSWORD=
# System administrator account, used only by the import script, to create the
# PipelineSequential rule-engine queue (queues are system-wide in ThingsBoard
# CE). The ThingsBoard CE public defaults are sysadmin@thingsboard.org /
# sysadmin; set the password in .env.
TB_SYSADMIN_USERNAME=sysadmin@thingsboard.org
TB_SYSADMIN_PASSWORD=

# Kafka and Schema Registry
KAFKA_BOOTSTRAP=localhost:9092
SCHEMA_REGISTRY_URL=http://localhost:8081
# Optional override. When empty, the topic name comes from config/topics.yaml,
# which is the single source of truth.
TELEMETRY_TOPIC=

# Firebase Realtime Database sink: optional, disabled by default.
FIREBASE_ENABLED=false
FIREBASE_DB_URL=
FIREBASE_DB_SECRET=
