{
  "type": "record",
  "name": "Telemetry",
  "namespace": "industrial_telemetry",
  "doc": "One sample from one asset of the synthetic plant. Version 1. All values are synthetic.",
  "fields": [
    {"name": "asset_id", "type": "string", "doc": "Asset identifier from config/telemetry.yaml; also the Kafka message key."},
    {"name": "asset_type", "type": "string", "doc": "Asset type, for example motor, pump or compressor."},
    {"name": "seq", "type": "long", "doc": "Per-asset sample sequence number, starting at 0 for each simulator run."},
    {"name": "ts", "type": {"type": "long", "logicalType": "timestamp-millis"}, "doc": "Sample time, UTC."},
    {"name": "synthetic", "type": "boolean", "doc": "Always true: the data is generated by the simulator."},
    {"name": "bearing_temperature_c", "type": ["null", "double"], "default": null, "doc": "Drive-end bearing housing temperature, degC."},
    {"name": "vibration_rms_mm_s", "type": ["null", "double"], "default": null, "doc": "Casing vibration, velocity RMS, mm/s."},
    {"name": "motor_current_a", "type": ["null", "double"], "default": null, "doc": "Motor phase current, RMS, A."},
    {"name": "speed_rpm", "type": ["null", "double"], "default": null, "doc": "Shaft speed, rpm."},
    {"name": "injected_fault", "type": ["null", "string"], "default": null, "doc": "Simulation ground truth: the fault mode active on this asset at this sample, or null. Exists only because the data is synthetic."}
  ]
}
